@@ -22,6 +22,25 @@
 /* This file contains some macOS-specific support code */
 
 #if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+#if defined(__APPLE__) && !TARGET_OS_OSX
+/* iOS/tvOS/visionOS: no AppKit. Log through Foundation; a fatal error goes to
+   stderr (there is no modal alert to raise from here). */
+#include <Foundation/Foundation.h>
+#include <stdio.h>
+#define SDL2_PRIVATE __attribute__((visibility("hidden")))
+SDL2_PRIVATE void SDL2Compat_NSLog(const char *prefix, const char *text)
+{
+    @autoreleasepool {
+        NSLog(@"%s%s", prefix ? prefix : "", text ? text : "");
+    }
+}
+SDL2_PRIVATE void error_dialog(const char *errorMsg)
+{
+    fprintf(stderr, "sdl2-compat: fatal error: %s\n", errorMsg ? errorMsg : "(null)");
+}
+#elif defined(__APPLE__)
 #include <Cocoa/Cocoa.h>
 
 #if __GNUC__ >= 4
