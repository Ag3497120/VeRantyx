    },
    "Hand tracking is not available on this Vision Pro.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このVision Proでは手のトラッキングを利用できません。"
          }
        }
      }
    },
    "Hand tracking is not allowed. Enable it for VeRantyx in Settings > Privacy & Security > Hand Tracking.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手の追跡が許可されていません。Vision Proの「設定 > プライバシーとセキュリティ > 手のトラッキング」でVeRantyxを許可してください。"
          }
        }
      }
    },
