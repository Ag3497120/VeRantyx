{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "waiting for audio": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声待ち"
          }
        }
      }
    },
    "Not connected (hand gestures control the game)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未接続（ハンドジェスチャーで操作）"
          }
        }
      }
    },
    "none": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし"
          }
        }
      }
    },
    "gyro %@ / accelerometer %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転 %1$@ / 加速度 %2$@"
          }
        }
      }
    },
    "Using %@ (position from hand tracking, motion sensors: %@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を使用中（位置はハンドトラッキング、モーション: %2$@）"
          }
        }
      }
    },
    "Joy-Con are connected separately. Press L and R on both at the same time to merge them into one controller.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジョイコンが1本ずつ接続されています。左右のL・Rボタンを同時に押して1つのコントローラーにまとめてください。"
          }
        }
      }
    },
    "Searching for the Mac encoder…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのエンコーダーを検索しています…"
          }
        }
      }
    },
    "Waiting for video packets.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像パケットを待っています。"
          }
        }
      }
    },
    "Connected to the Mac. Waiting for video from the encoder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに接続済み。エンコーダーから映像を待っています。"
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止中"
          }
        }
      }
    },
    "Connection to the Mac failed: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macへの接続に失敗しました: %@"
          }
        }
      }
    },
    "Search for the Mac failed: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの検索に失敗しました: %@"
          }
        }
      }
    },
    "Receiving video from the Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macから映像を受信中です。"
          }
        }
      }
    },
    "%lld packets received / %lld frames lost": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信 %1$lld パケット／欠落 %2$lld フレーム"
          }
        }
      }
    },
    "Video stopped arriving. Check SteamVR and the capture on the Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像受信が途切れています。Mac側のSteamVRとキャプチャを確認してください。"
          }
        }
      }
    },
    "Compositor not initialized yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Compositorはまだ初期化されていません。"
          }
        }
      }
    },
    "waiting for video": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像待ち"
          }
        }
      }
    },
    "display %lld fps / new frames %lld fps / audio %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示 %1$lld fps／新しい映像 %2$lld fps／音声 %3$@"
          }
        }
      }
    },
    "Waiting for HEVC video from the Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacからのHEVC映像を待っています。"
          }
        }
      }
    },
    "0 frames decoded": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デコード済み 0 フレーム"
          }
        }
      }
    },
    "Decoding fell behind; old frames dropped. Requesting a keyframe.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号が遅れたため古いフレームを捨てました。基準フレームを要求しています。"
          }
        }
      }
    },
    "Reconnected to the Mac. Waiting for an HEVC keyframe.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに再接続しました。HEVCの基準フレームを待っています。"
          }
        }
      }
    },
    "Lost video packets. Requesting a keyframe.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像パケットの欠落を検出。基準フレームを要求しています。"
          }
        }
      }
    },
    "Waiting for the HEVC keyframe and parameter sets.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVCの基準フレームと映像設定を待っています。"
          }
        }
      }
    },
    "Could not initialize the HEVC decoder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVCデコーダーを初期化できません。"
          }
        }
      }
    },
    "Restarting video decoding (%lld).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像の復号を再開しています (%lld)。"
          }
        }
      }
    },
    "Decoding HEVC video.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC映像をデコードしています。"
          }
        }
      }
    },
    "%lld decoded / %lld gaps / %lld recoveries / %lld queued / %lld dropped late": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デコード済み %1$lld／欠落 %2$lld／復旧 %3$lld／待ち %4$lld／遅延破棄 %5$lld"
          }
        }
      }
    },
    "Video decoding stalled. Requesting a keyframe.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像の復号が途切れています。基準フレームを再取得しています。"
          }
        }
      }
    },
    "tracked": {
      "localizations": {
