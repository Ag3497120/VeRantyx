    },
    "separate Joy-Con, sensors per hand": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右別々のジョイコン。センサーは両手"
          }
        }
      }
    },
    "Using %@ (%@; position from hand tracking, motion sensors: %@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を使用中（%2$@。位置はハンドトラッキング、モーションセンサー: %3$@）"
          }
        }
      }
    },
    "Hold the merged Joy-Con pair in the left hand (right hand free)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合体したジョイコンを左手だけで持つ（右手は自由）"
          }
        }
      }
    },
    "merged pair held in the left hand (ZR/R, both sticks, arrows, A/B/X/Y); the right hand uses gestures": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合体ペアを左手で保持（ZR/R・両スティック・矢印・A/B/X/Y）。右手はジェスチャー"
          }
        }
      }
