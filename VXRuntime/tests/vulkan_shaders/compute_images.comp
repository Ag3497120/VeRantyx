// Storage images (written, and read-modify-written), a uniform texel buffer, a storage texel buffer with atomics, a
// dynamic uniform buffer and a runtime array of sampled images (partially bound) indexed non-uniformly with a
// separate sampler.
#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 1, r32f) uniform image2D accum;
layout(set = 0, binding = 2) uniform samplerBuffer texels;
layout(set = 0, binding = 3, r32ui) uniform uimageBuffer counts;
layout(set = 0, binding = 4) uniform Params { vec4 tint; } params;
layout(set = 1, binding = 0) uniform texture2D textures[];
layout(set = 1, binding = 1) uniform sampler samp;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    uint k = uint(p.x + p.y) % 3u;
    vec4 c = texelFetch(sampler2D(textures[nonuniformEXT(k)], samp), ivec2(0), 0);
    float t = texelFetch(texels, p.x).r;
    float a = imageLoad(accum, p).r;
    imageStore(accum, p, vec4(a + t));
    imageStore(outImg, p, c * params.tint);
    imageAtomicAdd(counts, int(k), 1u);
}
